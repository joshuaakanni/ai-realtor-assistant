                  "description": null
                },
                {
                  "name": "budget",
                  "required": true,
                  "description": null
                },
                {
                  "name": "bedrooms",
                  "required": true,
                  "description": null
                },
                {
                  "name": "bathrooms",
                  "required": true,
                  "description": null
                },
                {
                  "name": "move_in_timeline",
                  "required": true,
                  "description": null
                },
                {
                  "name": "financing_method",
                  "required": true,
                  "description": null
                },
                {
                  "name": "must_have_features",
                  "required": true,
                  "description": null
                },
                {
                  "name": "additional_notes",
                  "required": true,
                  "description": null
