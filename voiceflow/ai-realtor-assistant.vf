    {
      "id": "6a5fa51d84cfe5189e93d409",
      "discriminatorID": "6a5fa50e84cfe5189e93d401",
      "text": [
        {
          "text": [
            "Sorry, I didn't catch that. Are you a potential home buyer, a real estate agent, or just browsing?"
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2026-07-22T00:29:25.000Z"
    },
    {
      "id": "6a5fa79484cfe5189e93d423",
      "discriminatorID": "6a5fa79484cfe5189e93d422",
      "text": [
        {
          "text": [
            "Alright! So what would you like to do today?"
