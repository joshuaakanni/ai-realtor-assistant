        "usedIntentsSet": [],
        "functionDefinitions": {
          "6a5f3b45ff0e0c39c847fc41": {
            "name": "Validate Email Format",
            "codeId": "6a600ee5c3c411705a5ad275-6a5f3b45ff0e0c39c847fc41-iipoilbe.js",
            "description": "Never save the user's raw email directly to {email}.\n\nFirst run \"Validate Email Format\" using the exact email provided.\n\nOnly when {email_is_valid} is true:\n- Set {email} = {validated_email}\n- Continue to the next question.\n\nWhen {email_is_valid} is false:\n- Keep {email} empty.\n- Explain the problem using {email_validation_message}.\n- Ask for the email again.",
            "inputVars": {
              "email_to_validate": {
                "type": "text",
                "description": "The complete email address exactly as provided by the user, before it is accepted or saved."
              }
            },
            "outputVars": {
              "email_is_valid": {
                "type": "text",
                "description": "Returns true when the email has a valid practical format; otherwise returns false."
              },
              "validated_email": {
                "type": "text",
                "description": "Returns the cleaned lowercase email when valid. Returns an empty value when invalid."
              },
              "email_validation_message": {
                "type": "text",
                "description": "Returns a natural explanation of what is wrong, or confirms that the format is valid."
              }
            },
            "pathCodes": []
          },
          "6a5fd0cabcdbc46a870f8291": {
            "name": "Validate Requested Date and Time V2",
            "codeId": "6a600ee5c3c411705a5ad275-6a5fd0cabcdbc46a870f8291-mffkpgbb.js",
            "description": "Use this tool whenever the user provides or changes an exact callback, tour, appointment, or follow-up date and time.\n\nRun it even when the date and time appear inside a longer message.\n\nBefore calling the tool:\n\n- Convert the date to YYYY-MM-DD.\n- Convert the time to 24-hour HH:mm format.\n- Provide the applicable IANA timezone, such as Africa/Lagos or America/Chicago.\n\nUse this tool before accepting, saving, or describing an exact date and time as valid.\n\nRun it again whenever the user corrects or changes the date or time.\n\nDo not use it for general recurring preferences such as “weekday afternoons,” “weekends,” or “anytime.”",
            "inputVars": {
              "date_to_validate": {
                "type": "text",
                "description": "The exact requested local calendar date converted to YYYY-MM-DD format, such as 2026-07-30."
              },
              "time_to_validate": {
                "type": "text",
                "description": "The exact requested local time converted to 24-hour HH:mm format, such as 14:00."
              },
              "timezone_to_validate": {
                "type": "text",
                "description": "The valid IANA timezone in which the requested date and time should be interpreted, such as Africa/Lagos, America/Chicago, or Europe/London."
              }
            },
            "outputVars": {
              "datetime_is_valid": {
                "type": "text",
                "description": "Returns true only when the supplied date, time, and timezone are valid and the requested moment is strictly in the future. Returns false otherwise."
              },
              "normalized_date": {
                "type": "text",
                "description": "Returns the validated requested date in YYYY-MM-DD format. Returns an empty string when validation fails."
              },
              "normalized_time": {
                "type": "text",
                "description": "Returns the validated requested time in 24-hour HH:mm format. Returns an empty string when validation fails."
              },
              "current_local_datetime": {
                "type": "text",
                "description": "Returns the current date and time in the supplied IANA timezone for reference during validation."
              },
              "datetime_validation_message": {
                "type": "text",
                "description": "Returns a clear explanation of whether validation succeeded or why the supplied date, time, or timezone was rejected."
              },
              "validated_datetime_display": {
                "type": "text",
                "description": "Returns the validated future date, local time, and IANA timezone as one display-ready value, such as “2026-07-30 at 14:00 (Africa/Lagos)”. Returns an empty string when validation fails."
              },
              "requested_datetime_utc": {
                "type": "text",
                "description": "Returns the validated requested local date and time converted into an ISO 8601 UTC timestamp. Returns an empty string when validation fails."
              }
            },
            "pathCodes": []
          }
        },
