  "integrationTools": [],
  "functions": [
    {
      "id": "6a5f3b45ff0e0c39c847fc41",
      "name": "Validate Email Format",
      "folderID": null,
      "code": "export default async function main(args) {\nconst email = String(\n  args.inputVars.email_to_validate ?? ''\n)\n  .trim()\n  .toLowerCase();\n\nconst isValid =\n  /^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/i.test(email) &&\n  !email.includes('..') &&\n  !email.startsWith('.') &&\n  !email.endsWith('.') &&\n  !email.includes('.@') &&\n  !email.includes('@.');\n\nreturn {\n  outputVars: {\n    email_is_valid: isValid,\n    validated_email: isValid ? email : '',\n    email_validation_message: isValid\n      ? 'The email address format is valid.'\n      : 'Please enter a complete email address such as name@example.com.',\n  },\n};\n}",
      "image": null,
      "description": "Never save the user's raw email directly to {email}.\n\nFirst run \"Validate Email Format\" using the exact email provided.\n\nOnly when {email_is_valid} is true:\n- Set {email} = {validated_email}\n- Continue to the next question.\n\nWhen {email_is_valid} is false:\n- Keep {email} empty.\n- Explain the problem using {email_validation_message}.\n- Ask for the email again.",
      "pathOrder": [],
      "settings": null,
      "createdAt": "2026-07-22T00:29:25.000Z",
      "updatedAt": "2026-07-22T00:29:25.000Z"
    },
    {
      "id": "6a5f51e9ff0e0c39c847fd30",
      "name": "Validate Requested Date and Time",
      "folderID": null,
      "code": "export default async function main(args) {\nexport default async function main(args) {\n  const dateInput = String(\n    args.inputVars.date_to_validate ?? ''\n  ).trim();\n\n  const timeInput = String(\n    args.inputVars.time_to_validate ?? ''\n  ).trim();\n\n  const timezone = String(\n    args.inputVars.timezone_to_validate ?? ''\n  ).trim();\n\n  return {\n    outputVars: {\n      datetime_is_valid: true,\n      normalized_date: dateInput,\n      normalized_time: timeInput,\n      requested_datetime_utc: 'TEST',\n      current_local_datetime: 'TEST',\n      datetime_validation_message:\n        'The Function structure is working.',\n      validated_datetime_display:\n        `${dateInput} at ${timeInput} (${timezone})`\n    }\n  };\n}\n}",
      "image": null,
      "description": null,
      "pathOrder": [],
      "settings": null,
      "createdAt": "2026-07-22T00:29:25.000Z",
      "updatedAt": "2026-07-22T00:29:25.000Z"
    },
    {
      "id": "6a5fd0cabcdbc46a870f8291",
      "name": "Validate Requested Date and Time V2",
      "folderID": null,
      "code": "export default async function main(args) {\n  const { inputVars } = args;\n\n  const dateInput = String(\n    inputVars.date_to_validate ?? ''\n  ).trim();\n\n  const timeInput = String(\n    inputVars.time_to_validate ?? ''\n  ).trim();\n\n  const timezone = String(\n    inputVars.timezone_to_validate ?? ''\n  ).trim();\n\n  function invalid(\n    message,\n    currentLocalDatetime = ''\n  ) {\n    return {\n      outputVars: {\n        datetime_is_valid: false,\n        normalized_date: '',\n        normalized_time: '',\n        requested_datetime_utc: '',\n        current_local_datetime:\n          currentLocalDatetime,\n        datetime_validation_message:\n          message,\n        validated_datetime_display: ''\n      }\n    };\n  }\n\n  if (!timezone) {\n    return invalid(\n      'The timezone is missing. Please confirm the timezone for this request.'\n    );\n  }\n\n  try {\n    new Intl.DateTimeFormat('en-US', {\n      timeZone: timezone\n    }).format(new Date());\n  } catch (error) {\n    return invalid(\n      'The selected timezone is not valid. Please confirm the correct location or timezone.'\n    );\n  }\n\n  function getTimezoneParts(timestamp) {\n    const parts =\n      new Intl.DateTimeFormat('en-GB', {\n        timeZone: timezone,\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit',\n        hour: '2-digit',\n        minute: '2-digit',\n        second: '2-digit',\n        hour12: false,\n        hourCycle: 'h23'\n      }).formatToParts(new Date(timestamp));\n\n    function getValue(type) {\n      const part = parts.find(\n        (item) => item.type === type\n      );\n\n      return part\n        ? Number(part.value)\n        : NaN;\n    }\n\n    return {\n      year: getValue('year'),\n      month: getValue('month'),\n      day: getValue('day'),\n      hour: getValue('hour'),\n      minute: getValue('minute'),\n      second: getValue('second')\n    };\n  }\n\n  function pad(value) {\n    return String(value).padStart(2, '0');\n  }\n\n  const now = Date.now();\n  const nowParts = getTimezoneParts(now);\n\n  const currentLocalDatetime =\n    `${nowParts.year}-${pad(nowParts.month)}-${pad(nowParts.day)} ` +\n    `${pad(nowParts.hour)}:${pad(nowParts.minute)}:${pad(nowParts.second)} ` +\n    `(${timezone})`;\n\n  const dateMatch =\n    /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(\n      dateInput\n    );\n\n  if (!dateMatch) {\n    return invalid(\n      'Please provide the date in YYYY-MM-DD format.',\n      currentLocalDatetime\n    );\n  }\n\n  const year = Number(dateMatch[1]);\n  const month = Number(dateMatch[2]);\n  const day = Number(dateMatch[3]);\n\n  const dateCheck = new Date(\n    Date.UTC(year, month - 1, day)\n  );\n\n  if (\n    dateCheck.getUTCFullYear() !== year ||\n    dateCheck.getUTCMonth() !== month - 1 ||\n    dateCheck.getUTCDate() !== day\n  ) {\n    return invalid(\n      'That calendar date is not valid. Please choose a valid date.',\n      currentLocalDatetime\n    );\n  }\n\n  const timeMatch =\n    /^([01]\\d|2[0-3]):([0-5]\\d)$/.exec(\n      timeInput\n    );\n\n  if (!timeMatch) {\n    return invalid(\n      'Please provide the time in 24-hour HH:mm format, such as 14:30.',\n      currentLocalDatetime\n    );\n  }\n\n  const hour = Number(timeMatch[1]);\n  const minute = Number(timeMatch[2]);\n\n  const desiredAsUtc = Date.UTC(\n    year,\n    month - 1,\n    day,\n    hour,\n    minute,\n    0\n  );\n\n  let requestedTimestamp = desiredAsUtc;\n\n  for (\n    let attempt = 0;\n    attempt < 4;\n    attempt += 1\n  ) {\n    const observed =\n      getTimezoneParts(requestedTimestamp);\n\n    const observedAsUtc = Date.UTC(\n      observed.year,\n      observed.month - 1,\n      observed.day,\n      observed.hour,\n      observed.minute,\n      0\n    );\n\n    requestedTimestamp +=\n      desiredAsUtc - observedAsUtc;\n  }\n\n  const verified =\n    getTimezoneParts(requestedTimestamp);\n\n  if (\n    verified.year !== year ||\n    verified.month !== month ||\n    verified.day !== day ||\n    verified.hour !== hour ||\n    verified.minute !== minute\n  ) {\n    return invalid(\n      'That local date and time does not exist in the selected timezone. Please choose another time.',\n      currentLocalDatetime\n    );\n  }\n\n  if (requestedTimestamp <= now) {\n    return invalid(\n      `That date and time has already passed in ${timezone}. Please choose a future date and time.`,\n      currentLocalDatetime\n    );\n  }\n\n  return {\n    outputVars: {\n      datetime_is_valid: true,\n      normalized_date: dateInput,\n      normalized_time: timeInput,\n      requested_datetime_utc:\n        new Date(requestedTimestamp).toISOString(),\n      current_local_datetime:\n        currentLocalDatetime,\n      datetime_validation_message:\n        'The requested date and time are valid and in the future.',\n      validated_datetime_display:\n        `${dateInput} at ${timeInput} (${timezone})`\n    }\n  };\n}",
      "image": null,
      "description": "Use this tool whenever the user provides or changes an exact callback, tour, appointment, or follow-up date and time.\n\nRun it even when the date and time appear inside a longer message.\n\nBefore calling the tool:\n\n- Convert the date to YYYY-MM-DD.\n- Convert the time to 24-hour HH:mm format.\n- Provide the applicable IANA timezone, such as Africa/Lagos or America/Chicago.\n\nUse this tool before accepting, saving, or describing an exact date and time as valid.\n\nRun it again whenever the user corrects or changes the date or time.\n\nDo not use it for general recurring preferences such as “weekday afternoons,” “weekends,” or “anytime.”",
      "pathOrder": [],
      "settings": null,
      "createdAt": "2026-07-22T00:29:25.000Z",
      "updatedAt": "2026-07-22T00:29:25.000Z"
    }
  ],
