          },
          "name": "Schedule Tour",
          "apiTools": [],
          "flowTools": [],
          "pathTools": [
            {
              "id": "6a5e024b2d3a281a6d62ac71",
              "name": "Tour details confirmed",
              "messages": null,
              "description": "All required tour information has been collected, the user has reviewed the summary, and the user has clearly confirmed that the details are correct.",
              "variables": [
                {
                  "name": "name",
                  "required": true,
                  "description": null
                },
                {
                  "name": "phone",
                  "required": true,
                  "description": null
