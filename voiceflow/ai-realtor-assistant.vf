  "workflows": [
    {
      "id": "66df755be937eb000784abb2",
      "name": "Default",
      "folderID": null,
      "status": null,
      "isStart": true,
      "diagramID": "64dbb6696a8fab0013dba194",
      "assigneeID": null,
      "description": "",
