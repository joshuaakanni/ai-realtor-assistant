        "6a5aaa08e77e91eef455a05e": {
          "endTool": null,
          "settings": {
            "model": "voiceflow-core-4.1",
            "maxTokens": 10000,
            "temperature": 0.3,
            "reasoningEffort": null
          },
          "cardTool": null,
          "isOperator": false,
          "buttonTool": null,
          "description": "Use this playbook whenever the user wants help finding, comparing, or identifying a suitable home, community, property, model home, or floor plan based on preferences such as area, budget, bedrooms, bathrooms, move-in timeline, financing, features, or amenities.",
          "skipTurnTool": null,
          "carouselTool": null,
          "webSearchTool": {
            "enabled": false,
            "messages": null,
            "toolSound": null,
            "description": ""
          },
          "name": "Find a Home",
          "apiTools": [],
          "flowTools": [],
          "pathTools": [
            {
              "id": "6a5e06562d3a281a6d62ac84",
              "name": "Home search complete",
              "messages": null,
              "description": "The user's search requirements have been collected, stored, summarized, and confirmed; verified recommendations or a clear no-match response have been provided; the user has chosen whether to request a tour, request Justin follow-up, or take no further action; and all required home-search and handoff variables have been populated.",
              "variables": [
                {
                  "name": "visitor_type",
                  "required": true,
                  "description": null
                },
                {
                  "name": "preferred_area",
                  "required": true,
                  "description": null
                },
                {
                  "name": "preferred_property",
