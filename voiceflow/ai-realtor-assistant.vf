        "6a5e103d2d3a281a6d62acd1": {
          "name": "Submit Tour Request",
          "description": "Submit the confirmed tour-request details to n8n after the user has reviewed the summary and confirmed that all details are correct. Do not submit before confirmation.",
          "apiCall": {
            "url": "https://YOUR_N8N_DOMAIN/webhook/book-tour-demo",
            "body": [],
            "method": "POST",
            "params": [],
            "headers": [
              {
                "key": "Content-Type",
                "val": "application/json"
              }
            ],
            "content": "{\n  \"name\": \"{name}\",\n  \"phone\": \"{phone}\",\n  \"email\": \"{email}\",\n  \"visitor_type\": \"{visitor_type}\",\n  \"tour_type\": \"{tour_type}\",\n  \"community\": \"{community}\",\n  \"property\": \"{property}\",\n  \"preferred_date\": \"{preferred_date}\",\n  \"preferred_time\": \"{preferred_time}\",\n  \"preferred_datetime_utc\": \"{preferred_datetime_utc}\",\n  \"alternative_date\": \"{alternative_date}\",\n  \"alternative_time\": \"{alternative_time}\",\n  \"alternative_datetime_utc\": \"{alternative_datetime_utc}\",\n  \"requested_time_timezone\": \"{requested_time_timezone}\",\n  \"number_of_guests\": \"{number_of_guests}\",\n  \"special_instructions\": \"{special_instructions}\",\n  \"preferred_contact_method\": \"{preferred_contact_method}\"\n}",
            "bodyInputType": "rawInput",
            "selected_action": "Make a POST Request"
          },
          "inputVariables": {
            "name": {
              "description": "The user’s full name as confirmed in the tour-request summary."
            },
            "phone": {
