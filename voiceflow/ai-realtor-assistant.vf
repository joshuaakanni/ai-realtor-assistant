              "description": "The kind of tour being requested. For this workflow, use the fixed value Model Home Tour."
            },
            "community": {
              "description": "The community the user wants to visit."
            },
            "property": {
              "description": "The specific property, model home, or floor plan the user wants to tour. Use Not specified when only the community is known."
            },
            "preferred_date": {
              "description": "The user’s first-choice exact calendar date for the tour, including day, month, and year."
            },
            "preferred_time": {
              "description": "The user’s first-choice time or clear time window for the tour."
            },
            "alternative_date": {
              "description": "An optional second-choice exact calendar date. Use Not specified when none is provided."
            },
            "alternative_time": {
              "description": "An optional second-choice time or time window. Use Not specified when none is provided."
            },
            "number_of_guests": {
              "description": "The total number of people expected to attend the tour. Use Not specified when the user does not provide it."
            },
            "special_instructions": {
              "description": "Any accessibility needs, special requests, or additional notes for the tour. Use Not specified when none are provided."
            },
            "preferred_contact_method": {
              "description": "The user’s preferred method for receiving confirmation: Phone Call, Text Message, or Email."
            },
            "requested_time_timezone": {
              "description": "The valid IANA timezone used to interpret the customer’s preferred and alternative tour dates and times, such as America/Chicago."
            },
            "preferred_datetime_utc": {
              "description": "The customer’s validated preferred tour date and time converted to an ISO 8601 UTC timestamp."
            },
            "alternative_datetime_utc": {
              "description": "The customer’s validated alternative tour date and time converted to an ISO 8601 UTC timestamp. Use “Not specified” when no alternative date and time was provided."
            }
          }
        },
        "6a5e44d7c101d7327b6e6097": {
          "name": "Submit Justin Contact Request",
          "description": "Send the user's confirmed contact request to the n8n escalation webhook after the user has reviewed the complete summary and confirmed that all details are correct. Use only for the Leave a Message for Justin workflow. Do not submit before confirmation.",
          "apiCall": {
            "url": "https://YOUR_N8N_DOMAIN/webhook/contact-request-demo",
            "body": [],
            "method": "POST",
            "params": [],
            "headers": [
              {
                "key": "Content-Type",
                "val": "application/json"
              }
            ],
            "content": "{\n  \"name\": \"{name}\",\n  \"phone\": \"{phone}\",\n  \"email\": \"{email}\",\n  \"reason_for_contact\": \"{reason_for_contact}\",\n  \"message\": \"{message}\",\n  \"community_or_property\": \"{community_or_property}\",\n  \"urgency\": \"{urgency}\",\n  \"preferred_contact_method\": \"{preferred_contact_method}\",\n  \"best_time_to_contact\": \"{best_time_to_contact}\",\n  \"requested_time_timezone\": \"{requested_time_timezone}\",\n  \"requested_datetime_utc\": \"{requested_datetime_utc}\"\n}",
            "bodyInputType": "rawInput",
            "selected_action": "Make a POST Request"
          },
          "inputVariables": {
            "name": {
              "description": "The user’s full name as confirmed in the contact-request summary."
            },
            "phone": {
              "description": "The user’s phone number exactly as provided. Use Not specified when no phone number was provided."
            },
            "email": {
              "description": "The user’s email address. Use Not specified when no email address was provided."
            },
            "reason_for_contact": {
              "description": "The confirmed category describing why the user wants Justin to contact them."
            },
            "message": {
              "description": "The complete message the user wants Justin to receive, preserving its meaning and important details."
            },
            "community_or_property": {
              "description": "The relevant community, property, model home, or floor plan. Use Not specified when it is unrelated or unknown."
            },
            "urgency": {
              "description": "The urgency level of the request: Normal or Urgent."
            },
            "preferred_contact_method": {
              "description": "The user’s confirmed preferred contact method: Phone Call, Text Message, or Email."
            },
            "best_time_to_contact": {
              "description": "The user’s preferred time or time window for Justin to contact them."
            },
            "requested_time_timezone": {
              "description": "The valid IANA timezone used to interpret the customer’s requested callback date and time, such as Africa/Lagos."
            },
            "requested_datetime_utc": {
              "description": "The customer’s validated callback date and time converted to an ISO 8601 UTC timestamp."
            }
          }
        },
        "6a5e5e8ec101d7327b6e61cc": {
          "name": "Submit Incentive Interaction",
          "description": "Send the completed incentive interaction to the n8n Incentive Request webhook after the user's question has been answered or identified as unverifiable, the user has clearly stated whether Justin follow-up is requested, and all required variables have been populated. Use only in the Incentives workflow. Do not submit before the Incentive interaction complete exit condition is reached.",
          "apiCall": {
            "url": "https://YOUR_N8N_DOMAIN/webhook/incentive-request-demo",
            "body": [],
            "method": "POST",
            "params": [],
            "headers": [
              {
                "key": "Content-Type",
                "val": "application/json"
              }
            ],
            "content": "{\n  \"community\": \"{community}\",\n  \"property\": \"{property}\",\n  \"incentive_topic\": \"{incentive_topic}\",\n  \"incentive_question\": \"{incentive_question}\",\n  \"information_status\": \"{information_status}\",\n  \"answer_summary\": \"{answer_summary}\",\n  \"financing_method\": \"{financing_method}\",\n  \"preferred_lender_status\": \"{preferred_lender_status}\",\n  \"move_in_or_closing_timeline\": \"{move_in_or_closing_timeline}\",\n  \"follow_up_requested\": \"{follow_up_requested}\",\n  \"request_status\": \"{request_status}\"\n}",
            "bodyInputType": "rawInput",
            "selected_action": "Make a POST Request"
          },
          "inputVariables": {
            "community": {
              "description": "The community the user’s incentive question concerns."
            },
            "property": {
              "description": "The specific property, model home, or floor plan involved. Use Not specified when only the community is known."
            },
            "incentive_topic": {
              "description": "The incentive category, such as Closing-Cost Assistance, Rate Buy-Down, Builder Credit, Price Discount, Preferred-Lender Incentive, Temporary Promotion, or Other."
            },
            "incentive_question": {
              "description": "The user’s exact incentive question, preserving its meaning and relevant details."
            },
            "information_status": {
              "description": "Whether the answer was verified from the Knowledge Base. Use Verified or Unavailable."
            },
            "answer_summary": {
              "description": "A concise summary of the verified answer or the explanation that current information could not be verified."
            },
            "financing_method": {
              "description": "The user’s financing method when relevant. Use Not specified when unknown or irrelevant."
            },
            "preferred_lender_status": {
              "description": "Whether the user intends to use the preferred lender. Use Yes, No, Undecided, or Not specified."
            },
            "move_in_or_closing_timeline": {
              "description": "The user’s move-in or closing timeline when relevant. Use Not specified when unknown or irrelevant."
            },
            "follow_up_requested": {
              "description": "Whether the user wants Justin to follow up. Use Yes or No."
            },
            "request_status": {
              "description": "The final interaction status: Answered, Information Unavailable, or Follow-up Requested."
            }
          }
        },
        "6a5e8dfc1458169080e3994e": {
          "name": "Submit Home Search",
          "description": "Use this tool after the Find a Home playbook has completed, the visitor’s confirmed search requirements and recommendation result have been saved, and next_action is Tour Requested, Follow-up Requested, or No Further Action. Submit the home-search record before routing to the next workflow. Do not use it while information is still being collected or more than once for the same search.",
          "apiCall": {
            "url": "https://YOUR_N8N_DOMAIN/webhook/find-a-home-demo",
            "body": [],
            "method": "POST",
            "params": [],
            "headers": [
              {
                "key": "Content-Type",
                "val": "application/json"
              }
            ],
            "content": "{\n  \"name\": \"{name}\",\n  \"phone\": \"{phone}\",\n  \"email\": \"{email}\",\n  \"visitor_type\": \"{visitor_type}\",\n  \"preferred_area\": \"{preferred_area}\",\n  \"preferred_property\": \"{preferred_property}\",\n  \"budget\": \"{budget}\",\n  \"bedrooms\": \"{bedrooms}\",\n  \"bathrooms\": \"{bathrooms}\",\n  \"move_in_timeline\": \"{move_in_timeline}\",\n  \"financing_method\": \"{financing_method}\",\n  \"must_have_features\": \"{must_have_features}\",\n  \"additional_notes\": \"{additional_notes}\",\n  \"match_status\": \"{match_status}\",\n  \"recommendation_summary\": \"{recommendation_summary}\",\n  \"selected_option\": \"{selected_option}\",\n  \"next_action\": \"{next_action}\",\n  \"preferred_contact_method\": \"{preferred_contact_method}\",\n  \"best_time_to_contact\": \"{best_time_to_contact}\"\n}",
            "bodyInputType": "rawInput",
            "selected_action": "Make a POST Request"
          },
          "inputVariables": {
            "name": {
              "description": "The visitor’s full name. Use Not specified when no name has been provided."
            },
            "phone": {
              "description": "The visitor’s phone number, preserved exactly as entered. Use Not specified when unavailable."
            },
            "email": {
              "description": "The visitor’s email address. Use Not specified when unavailable."
            },
            "visitor_type": {
              "description": "The visitor category: Home Buyer, Realtor, or Just Looking / Other."
            },
            "preferred_area": {
              "description": "The city, neighbourhood, area, or community where the visitor wants to find a home."
            },
            "preferred_property": {
              "description": "A specific property, model home, or floor plan requested by the visitor. Use Not specified when none was requested."
            },
            "budget": {
              "description": "The visitor’s stated home-buying budget or price range, preserved in the form they provided."
            },
            "bedrooms": {
              "description": "The visitor’s required or preferred number of bedrooms, including flexible or minimum requirements."
            },
            "bathrooms": {
              "description": "The visitor’s required or preferred number of bathrooms, including flexible or minimum requirements."
            },
            "move_in_timeline": {
              "description": "The visitor’s preferred move-in timeframe or valid future move-in date."
            },
            "financing_method": {
              "description": "The intended payment or financing method: Cash, Mortgage, Undecided, or Not specified."
            },
            "must_have_features": {
              "description": "The home or community features the visitor considers important. Use Not specified when none were provided."
            },
            "additional_notes": {
              "description": "Any other relevant information about the visitor’s home-search needs. Use Not specified when none was provided."
            },
            "match_status": {
              "description": "The home-search result: Match Found, Partial Match Found, or No Match Found."
            },
            "recommendation_summary": {
              "description": "A concise summary of the verified options recommended and why they match, or a concise explanation of the no-match result."
            },
            "selected_option": {
              "description": "The community, property, model home, or floor plan selected for a tour or Justin follow-up. Use Not specified when none was selected."
            },
            "next_action": {
              "description": "The visitor’s chosen next step: Tour Requested, Follow-up Requested, or No Further Action."
            },
            "preferred_contact_method": {
              "description": "The visitor’s preferred method of contact, such as Phone Call, Text Message, or Email. Use Not specified when not collected."
            },
            "best_time_to_contact": {
              "description": "The visitor’s valid preferred future date, time, or recurring time window for contact. Use Not specified when not collected."
            }
          }
        },
