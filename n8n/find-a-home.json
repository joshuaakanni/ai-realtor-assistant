    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Voiceflow data normally arrives inside `body`.\n// This also supports direct objects and stringified JSON.\nlet body = input.body ?? input;\n\nif (typeof body === 'string') {\n  try {\n    body = JSON.parse(body);\n  } catch {\n    body = {};\n  }\n}\n\nfunction clean(value, fallback = 'Not specified') {\n  if (\n    value === undefined ||\n    value === null ||\n    value === '' ||\n    value === 0 ||\n    value === '0'\n  ) {\n    return fallback;\n  }\n\n  return String(value).trim() || fallback;\n}\n\nfunction normalizeMatchStatus(value) {\n  const text = clean(value, 'No Match Found').toLowerCase();\n\n  if (text.includes('partial')) return 'Partial Match Found';\n  if (text.includes('no match')) return 'No Match Found';\n  if (text.includes('match found') || text === 'match') return 'Match Found';\n\n  return 'No Match Found';\n}\n\nfunction normalizeNextAction(value) {\n  const text = clean(value, 'No Further Action').toLowerCase();\n\n  if (text.includes('tour')) return 'Tour Requested';\n  if (text.includes('follow')) return 'Follow-up Requested';\n\n  return 'No Further Action';\n}\n\nconst nextAction = normalizeNextAction(body.next_action);\nconst matchStatus = normalizeMatchStatus(body.match_status);\n\nlet requestStatus = 'Completed';\n\nif (nextAction === 'Tour Requested') {\n  requestStatus = 'Tour Requested';\n} else if (nextAction === 'Follow-up Requested') {\n  requestStatus = 'Follow-up Requested';\n}\n\nconst requestedTimezone = clean(\n  body.business_timezone ??\n  body.requested_time_timezone ??\n  body.timezone,\n  'UTC'\n);\n\nlet timezone = requestedTimezone;\n\ntry {\n  new Intl.DateTimeFormat('en-US', {\n    timeZone: timezone,\n  }).format(new Date());\n} catch {\n  timezone = 'UTC';\n}\n\nconst now = new Date();\n\nconst dateSubmitted = new Intl.DateTimeFormat('en-CA', {\n  timeZone: timezone,\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit',\n}).format(now);\n\nconst timestamp = new Intl.DateTimeFormat('en-GB', {\n  timeZone: timezone,\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit',\n  hour: '2-digit',\n  minute: '2-digit',\n  second: '2-digit',\n  hour12: false,\n}).format(now);\n\nconst randomPart = Math.random().toString(36).slice(2, 8).toUpperCase();\nconst homeSearchId = `HOME-${Date.now()}-${randomPart}`;\n\nreturn [\n  {\n    json: {\n      home_search_id: homeSearchId,\n\n      name: clean(body.name),\n      phone: clean(body.phone),\n      email:\n        clean(body.email) === 'Not specified'\n          ? 'Not specified'\n          : clean(body.email).toLowerCase(),\n\n      visitor_type: clean(body.visitor_type),\n      preferred_area: clean(body.preferred_area),\n      preferred_property: clean(body.preferred_property),\n      budget: clean(body.budget),\n      bedrooms: clean(body.bedrooms),\n      bathrooms: clean(body.bathrooms),\n      move_in_timeline: clean(body.move_in_timeline),\n      financing_method: clean(body.financing_method),\n      must_have_features: clean(body.must_have_features),\n      additional_notes: clean(body.additional_notes),\n\n      match_status: matchStatus,\n      recommendation_summary: clean(body.recommendation_summary),\n      selected_option: clean(body.selected_option),\n      next_action: nextAction,\n\n      preferred_contact_method: clean(body.preferred_contact_method),\n      best_time_to_contact: clean(body.best_time_to_contact),\n\n      request_status: requestStatus,\n      submission_timezone: timezone,\n      date_submitted: dateSubmitted,\n      timestamp,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
